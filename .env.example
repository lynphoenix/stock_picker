# ============= AI模型配置 =============
# 使用 MiniMax AI (国产大模型)
# MiniMax API 兼容 Anthropic SDK 接口格式

# MiniMax API Key (必填)
ANTHROPIC_API_KEY=your-minimax-api-key-here
# 或使用别名
ANTHROPIC_AUTH_TOKEN=your-minimax-api-key-here

# MiniMax API 基础URL (必填)
# 例如：https://api.minimax.chat/v1
ANTHROPIC_BASE_URL=https://api.minimax.chat/v1

# MiniMax 模型名称 (可选，默认: MiniMax-M2.5)
# 可用模型: MiniMax-M2.5, MiniMax-M2.5-Chat 等
ANTHROPIC_MODEL=MiniMax-M2.5

# ============= 数据库配置 =============
# (其他配置...)
